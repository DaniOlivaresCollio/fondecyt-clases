as.integer(organization_assets) == 1 & as.integer(skills) %in% c(1, 2, 3) ~ 3,               # 3. Managers
as.integer(organization_assets) == 2 & as.integer(skills) %in% c(1, 2, 3) ~ 4,               # 4. Supervisors
as.integer(organization_assets) == 3 & as.integer(skills) == 1 ~ 5,                          # 5. Experts
as.integer(organization_assets) == 3 & as.integer(skills) %in% c(2, 3) & contrato == 1 ~ 6,  # 6. Formal workers
as.integer(organization_assets) == 3 & as.integer(skills) %in% c(2, 3) & contrato == 0 ~ 7,  # 7. Informal workers
as.integer(owners) == 1 & boleta == 0 ~ 8                                                    # 8. Informal self-employed
),
wrightclass_v7_reduced = factor(
wrightclass_v7_reduced,
levels = 1:8,
labels = c(
"1. Employers",
"2. Petty bourgeoisie",
"3. Managers",
"4. Supervisors",
"5. Experts",
"6. Formal workers",
"7. Informal workers",
"8. Informal self-employed"
)
)
) %>%
set_variable_labels(wrightclass_v7_reduced = "Wright Class Typology Reduced (v7)")
frq(data$wrightclass_v7_reduced)

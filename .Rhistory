e01 == 1 ~ 0,
e01 == 2 ~ 1
)
) %>%
set_variable_labels(female = "Gender (1 = female)") %>%
set_value_labels(female = c(
"Female" = 1,
"Male" = 0
))
frq(data$female)
descr(data$e02)
data <- data %>%
mutate(
age = if_else(
e02 %in% c(-888, -999), NA_real_, as.numeric(e02)
)
) %>%
set_variable_labels(age = "Age")
descr(data$age)
frq(data$a07)
data <- data %>%
mutate(
sector=case_when(
as.numeric(a07) %in% c(1, 2, 5, 6, 7, 9) ~ 1,
as.numeric(a07) %in% c(3, 4, 8) ~ 0,
.default = NA_real_
)) %>%
set_variable_labels(sector = "Sector (1 = private)") %>%
set_value_labels(sector = c(
"Private" = 1,
"Public" = 0
))
frq(data$sector)
frq(data$a25_rec)
data <- data %>%
mutate(
rama = factor(
case_when(
a25_rec == 1               ~ "A",
a25_rec %in% c(2, 3)       ~ "BC",
a25_rec %in% c(4, 5, 6)    ~ "DEF",
a25_rec %in% c(7, 8)       ~ "GI",
a25_rec == 9               ~ "H",
a25_rec %in% c(10:14)      ~ "JKLMN",
a25_rec == 15              ~ "O",
a25_rec %in% c(16, 17)     ~ "PQ",
a25_rec %in% c(18, 19, 20) ~ "RSU",
a25_rec == 21              ~ "T"
))
) %>%
set_variable_labels(rama = "Economic Activity")
frq(data$rama)
frq(data$c08)
data <- data %>%
mutate(
pol_id = factor(
case_when(
c08 %in% c(0, 1, 2, 3) ~ 1,
c08 %in% c(4, 5, 6) ~ 2,
c08 %in% c(7, 8, 9, 10) ~ 3,
c08 %in% c(11, 12, -888, -999) ~ 4,
.default = NA_real_
),
levels = 1:4,
labels = c(
"Left",
"Center",
"Right",
"Not identified"
)
)
) %>%
set_variable_labels(pol_id = "Political identification")
frq(data$pol_id)
frq(data$c08)
data <- data %>%
mutate(
left_id = if_else(
c08 %in% c(0, 1, 2, 3), 1, 0
)
) %>%
set_variable_labels(left_id = "Left identification (1 = yes") %>%
set_value_labels(left_id = c(
"Yes" = 1,
"No" = 0
))
frq(data$left_id)
frq(data$d01)
data <- data %>%
mutate(
workingclass_id = case_when(
d01 %in% c(1, 2, 3) ~ 1,
d01 %in% c(4, 5, 6, -888, -999) ~ 0,
.default = NA_real_
)
) %>%
set_variable_labels(workingclass_id = "Identification with the working class (1 = yes)") %>%
set_value_labels(workingclass_id = c(
"Yes" = 1,
"No" = 0
))
frq(data$workingclass_id)
frq(data$d02_01)
labs <- get_labels(data$d02_01, values = "n")
labs_clean <- labs[!names(labs) %in% c("-777", "-888", "-999")]
labs_num <- setNames(as.numeric(names(labs_clean)), labs_clean)
data <- data %>%
mutate(
workingclass_people_id = case_when(
workingclass_id == 0 ~ 0,
workingclass_id == 1 & d02_01 %in% c(-777, -888, -999) ~ 0,
workingclass_id == 1 & d02_01 == 1 ~ 1,
workingclass_id == 1 & d02_01 == 2 ~ 2,
workingclass_id == 1 & d02_01 == 3 ~ 3,
workingclass_id == 1 & d02_01 == 4 ~ 4,
workingclass_id == 1 & d02_01 == 5 ~ 5,
.default = NA_real_
)
) %>%
set_variable_labels(workingclass_people_id = "I identified with people from working class") %>%
set_value_labels(workingclass_people_id = labs_num)
frq(data$workingclass_people_id)
frq(data$d03)
frq(data$d03_esp)
data <- data %>%
mutate(
workingclass_id2 = case_when(
d03 == 4 ~ 1,
d03 == 5 ~ 2,
d03 == 6 ~ 3,
d03 %in% c(1, 2, 3, 7, -888, -999) ~ 4,
.default = NA_real_
)
) %>%
set_variable_labels(workingclass_id2 = "Identification with the working class (1 = yes) (2)") %>%
set_value_labels(workingclass_id2 = c(
"Clase trabajadora" = 1,
"Clase obrera" = 2,
"El pueblo" = 3,
"Otro" = 4
))
frq(data$workingclass_id2)
frq(data$b21)
frq(data$b25)
data <- data %>%
mutate(
union_org_member = case_when(
as.numeric(relation_mop) == 3 & b21 %in% c(1, 2) ~ 1,
as.numeric(relation_mop) == 3 & b21 %in% c(3, -888, -999, NA) ~ 0,
as.numeric(relation_mop) %in% c(1, 2) & b25 == 1 ~ 1,
as.numeric(relation_mop) %in% c(1, 2) & b25 %in% c(2, 3, 4, -888, -999, NA) ~ 0,
)) %>%
set_variable_labels(union_org_member = "Union or organization membership (1 = yes)") %>%
set_value_labels(union_org_member = c(
"Yes" = 1,
"No" = 0
)
)
frq(data$union_org_member)
saveRDS(data, file="output/data/data-marxismo-clases-cl.rds")
View(data)
rm(list=ls())
options(scipen = 999)
# install.packages("pacman")
library(pacman)
p_load(
# generacion docs
flextable,         # tablas personalizadas para word
kableExtra,        # mejorar tablas
knitr,             # generar reportes reproducibles
officer,           # crear/modifcar documentos word o ppt
tinytex,           # instalación mínima de LaTeX para generar PDF
# importacion datos
haven,             # impotar/exportar datos spss, stata, sas con etiquetas
readr,             # lectura rápida de csv
readxl,            # leer excel
# manipulacion
forcats,           # manipulación de factores
janitor,           # limpia etiquetas
labelled,          # trabajar con variables etiquetadas
purrr,             # programación funcional para listas y data frames
sjlabelled,        # manejar etiquetas
stringr,           # manipular texto
sjmisc,            # limpieza y descripción de datos
# visualizacion
ggplot2,           # visualización basado en gramática de gráficos
ggrepel,           # etiquetas en gráficos sin superposición
gridExtra,         # combinar gráficos en uno solo
scales,            # controla cómo se ven los ejes en gráficos
sjPlot,            # visualizar resultados estadísticos
# analisis
psych,             # análisis general, psicométrico
survey,            # diseño survey encuestas complejas
srvyr,             # diseño survey con tidy
rlang,             # motor interno de tidyverse, para usar expresiones
tidyverse,
statar             # conectar con el lenguaje stata
# # conexion web
# curl,              # conexiones http de bajo nivel: para solucionar el problema de la api del ine
# httr               # cliente http para API
)
data <- readRDS("output/data/data-marxismo-clases-cl.rds")
# base survey
data_svy <- as_survey_design(data, weights = pondera)
frq(data$wrightclass_v1_original)
data <- data %>%
mutate(
sexo = factor(
case_when(
e01 == 1 ~ "Hombre",
e01 == 2 ~ "Mujer"
)
)
) %>%
set_variable_labels(sexo = "Sexo")
# base survey
data_svy <- as_survey_design(data, weights = pondera)
#| fig-width: 8
#| fig-height: 8
# Calcular porcentajes ponderados por sexo
class_pct_sex <- data_svy %>%
filter(!is.na(wrightclass_v1_original), !is.na(sexo)) %>%
group_by(sexo, wrightclass_v1_original) %>%
summarise(pct = survey_mean(na.rm = TRUE) * 100, .groups = "drop")
# Calcular N válido (sin NA en ninguna de las dos variables)
n_valido <- data %>%
filter(!is.na(wrightclass_v1_original), !is.na(sexo)) %>%
nrow()
# Gráfico horizontal agrupado
grafico <- ggplot(class_pct_sex, aes(x = fct_rev(wrightclass_v1_original), y = pct, fill = sexo)) +
geom_col(position = position_dodge(width = 0.7), width = 0.65) +
geom_text(
aes(label = paste0(round(pct, 1), "%")),
position = position_dodge(width = 0.7),
hjust = -0.15,
size = 3.0,
color = "gray20"
) +
scale_fill_manual(values = c("Hombre" = "#ca0000", "Mujer" = "#ff5651")) +
scale_y_continuous(
limits = c(0, max(class_pct_sex$pct) * 1.18),
labels = scales::label_percent(scale = 1)
) +
coord_flip() +
labs(
title = "Distribución por clase social dentro de cada sexo",
subtitle = "Porcentajes ponderados",
x = "Clase social",
y = "Porcentaje",
fill = "Sexo",
caption = paste0("Fuente: Elaboración propia con datos de la Encuesta Conclat Chile 2024. Datos ponderados. N = ", n_valido)
) +
theme_minimal(base_size = 12) +
theme(
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
plot.title = element_text(face = "bold", color = "#6f0000"),
plot.subtitle = element_text(color = "grey40"),
plot.caption = element_text(size = 8, color = "gray40", hjust = 0.5),
legend.position = "right",
axis.title.y = element_text(margin = margin(r = 10))
)
grafico
ggsave("output/graph-clases/wrightclass_v1_sexo.png", plot = grafico, width = 8, height = 8, dpi = 300)
#| fig-width: 8
#| fig-height: 8

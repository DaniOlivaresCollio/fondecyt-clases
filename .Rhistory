frq(data$a33)
descr(data$a33)
data <- data %>%
mutate(
income = if_else(
a33 %in% c(-888, -999), NA_real_, as.numeric(a33)
)
) %>%
set_variable_labels(income = "Income")
descr(data$income)
frq(data$a34)
labs <- get_labels(data$a34, values = "n")
labs_clean <- labs[!names(labs) %in% c("-888", "-999")]  # excluye los missing
labs_num <- setNames(as.numeric(names(labs_clean)), labs_clean)
data <- data %>%
mutate(
income_br = if_else(
a34 %in% c(-888, -999), NA_real_, as.numeric(a34)
)
) %>%
set_variable_labels(income_br = "Income brackets") %>%
set_value_labels(income_br = labs_num)
frq(data$income_br)

# Coerciones una sola vez para evitar sorpresas con etiquetadas/labelled
data <- data %>%
mutate(
owners_i  = as.integer(owners),
org_i     = as.integer(organization_assets),
skills_i  = as.integer(skills)
) %>%
mutate(
wrightclass1_reduced5 = case_when(
# 1. Employers
owners_i == 3 & inicio_empresa == 1 & !is.na(income_rec) & income_rec >= 1000000 ~ 1L,
# 2. Small employers
owners_i == 3 & inicio_empresa == 1 & (income_rec < 1000000 | is.na(income_rec)) ~ 2L,
owners_i == 3 & inicio_empresa == 0 ~ 2L,
owners_i == 2 ~ 2L,
# 3. Petty bourgeoisie
owners_i == 1 & a06_boleta == 1 & a10 %in% 1:4 ~ 3L,
# 4. Expert managers
org_i == 1 & skills_i == 1 ~ 4L,
# 5. Experts
org_i == 3 & skills_i == 1 ~ 5L,
# 6. Skilled & Unskilled Supervisors
org_i %in% c(1, 2) & skills_i %in% c(2, 3) ~ 6L,
org_i == 2 & skills_i == 1 ~ 6L,
# 7. Formal workers
org_i == 3 & skills_i %in% c(2, 3) & a18 == 1 ~ 7L,
# 8. Informal workers
org_i == 3 & skills_i %in% c(2, 3) & a18 %in% c(2, 3, 4, -999) ~ 8L,
# 9. Informal self-employed
owners_i == 1 & a06_boleta == 0 & a10 %in% 1:5 ~ 9L,
owners_i == 1 & a06_boleta == 1 & a10 %in% 1:5 ~ 9L,
# Todo lo que no calza: NA explícito para poder contarlo
TRUE ~ NA_integer_
),
wrightclass1_reduced5 = factor(
wrightclass1_reduced5,
levels = 1:9,
labels = c(
"1. Employers",
"2. Small employers",
"3. Petty bourgeoisie",
"4. Expert managers",
"5. Experts",
"6. Skilled & Unskilled Supervisors",
"7. Formal workers",
"8. Informal workers",
"9. Informal self-employed"
)
)
)

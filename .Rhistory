group_by(wrightclass_v7_reduced) %>%
summarise(
freq = survey_mean(vartype = NULL, na.rm = TRUE),
n_unweighted = unweighted(n())
) %>%
mutate(
freq_pct = freq * 100
)
wright_freq %>%
print(n = Inf)

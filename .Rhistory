ordered = TRUE
)
) %>%
set_variable_labels(organization_assets = "Organizational Assets")
frq(data$organization_assets)
frq(data$educ)
data <- data %>%
mutate(
boleta = if_else(educ >= 9, 1, 0)
) %>%
set_variable_labels(boleta = "Issues receipts/invoices (1 = yes)") %>%
set_value_labels(boleta = c(
"Yes" = 1,
"No" = 0
))
frq(data$boleta)

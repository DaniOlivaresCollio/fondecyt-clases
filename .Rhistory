),
wrightclass1_reduced3_v2 = factor(
wrightclass1_reduced3_v2,
levels = 1:9,
labels = c(
"1. Formal workers",
"2. Informal workers",
"3. Informal self-employed",
"4. Skilled & Unskilled Supervisors",
"5. Experts",
"6. Expert managers",
"7. Petty bourgeoisie",
"8. Small employers",
"9. Employers"
)
)
) %>%
set_variable_labels(wrightclass1_reduced3_v2 = "Wright Class Typology Reduced (9v2)")
frq(data$wrightclass1_reduced3_v2)
# base survey
data_svy <- as_survey_design(data, weights = rake_wb2)
# Tabla de frecuencias ponderadas
wright_freq <- data_svy %>%
group_by(wrightclass1_reduced3_v2) %>%
summarise(
freq = survey_mean(vartype = NULL, na.rm = TRUE),
n_unweighted = unweighted(n())
) %>%
mutate(
freq_pct = freq * 100
)
wright_freq %>%
print(n = Inf)
rm(list=ls())
options(scipen = 999)
